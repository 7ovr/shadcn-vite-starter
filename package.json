{
  "name": "shadcn-vite-starter",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "lefthook install || exit 0",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/oxanium": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.5",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "shadcn": "4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "description": "A React starter with Vite, TanStack Router, Query and Form, and shadcn/ui on Base UI, set up for 7Ovr blocks.",
