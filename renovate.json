{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)",
    ":semanticCommitScopeDisabled"
  ],
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "1 day",
  "rangeStrategy": "bump",
  "automergeStrategy": "squash",
  "packageRules": [
    {
      "description": "Group stable minor and patch updates into one weekly PR that merges once CI passes",
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "groupName": "non-major dependencies",
      "groupSlug": "non-major",
      "automerge": true
    },
    {
      "description": "Keep the Node types on the Node major the project targets",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25"
    },
    {
      "description": "Keep the Node and pnpm floor in engines and CI, raised by hand",
      "matchDepNames": ["node", "pnpm"],
      "enabled": false
    }
  ]
}
